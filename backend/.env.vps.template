# VPS paste template — copy to .env, fill EVOLUTION_API_KEY + JWT + DB
# This file is safe to commit (no live secrets).

NODE_ENV=production
PORT=3000
APP_URL=https://api.YOUR-DOMAIN.com

TZ=Asia/Karachi
DEFAULT_CURRENCY=PKR

# Dokploy Postgres — internal host from service (example: gym-gy-atstal)
DATABASE_URL=postgresql://USER:PASSWORD@gym-gy-atstal:5432/DBNAME

# Dokploy Redis — example host: redis-yic3gd
REDIS_HOST=redis-yic3gd
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@redis-YOUR_SERVICE_ID:6379

JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_32_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

# Photos / PDFs — Cloudinary recommended on VPS (no disk volume needed)
STORAGE_DRIVER=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or separate vars: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=gym

# Local fallback (STORAGE_DRIVER=local)
STORAGE_LOCAL_PATH=./uploads

WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=evolution
WHATSAPP_COST_PER_MESSAGE=0.005

EVOLUTION_SERVER_URL=https://whastapp-evolutionapi-1020a5-13-63-149-197.sslip.io
EVOLUTION_API_KEY=PASTE_YOUR_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=gym

THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

SEED_OWNER_PHONE=03001234567
SEED_OWNER_PASSWORD=Owner@12345
SEED_GYM_NAME=Demo Fitness Club
