# =============================================================================
# Gym Management API — Environment Variables
# Copy to .env and adjust. NEVER commit .env.
# =============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TZ=Asia/Karachi
DEFAULT_CURRENCY=PKR

# -----------------------------------------------------------------------------
# DATABASE — choose ONE active DATABASE_URL
# -----------------------------------------------------------------------------
# REMOTE (primary for this project — default):
DATABASE_URL=postgresql://gy:k1972004pro@gym-gy-atstal:5432/gy

# LOCAL (docker-compose postgres, or local Postgres):
# Uncomment the line below and comment out the remote DATABASE_URL above to switch.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/gym

# How to switch:
# 1) Remote: keep DATABASE_URL pointing at gym-gy-atstal (default).
# 2) Local Docker: set DATABASE_URL=${DATABASE_URL_LOCAL} or uncomment the local URL.
# 3) docker-compose sets DATABASE_URL to the postgres service automatically.

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# File storage (local | cloudinary | s3)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gym
# S3-compatible (optional)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API or Evolution API (WHATSAPP_PROVIDER=meta|evolution)
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=gym-wa-verify-token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_COST_PER_MESSAGE=0.005

# Evolution API (when WHATSAPP_PROVIDER=evolution)
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=gym

# -----------------------------------------------------------------------------
# Rate limit / security
# -----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# -----------------------------------------------------------------------------
# Seed
# -----------------------------------------------------------------------------
SEED_OWNER_PHONE=03001234567
SEED_OWNER_PASSWORD=Owner@12345
SEED_GYM_NAME=Demo Fitness Club
